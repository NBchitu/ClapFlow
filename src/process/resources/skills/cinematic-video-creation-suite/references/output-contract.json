{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cinematic.video.storyboard.v1",
  "title": "Cinematic Video Storyboard Contract",
  "type": "object",
  "required": ["style", "scenes"],
  "properties": {
    "style": {
      "type": "object",
      "required": ["genre", "visualStyle", "colorPalette", "cameraPreferences"],
      "properties": {
        "genre": { "type": "string" },
        "visualStyle": { "type": "string" },
        "colorPalette": { "type": "string" },
        "cameraPreferences": { "type": "array", "items": { "type": "string" } },
        "referenceWorks": { "type": "array", "items": { "type": "string" } },
        "negativeStyle": { "type": "string" }
      }
    },
    "narrativeStructure": { "type": "string" },
    "keyThemes": { "type": "array", "items": { "type": "string" } },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "shots"],
        "properties": {
          "id": { "type": "string", "pattern": "^scene-\\d{2}$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "timeOfDay": { "type": "string" },
          "location": { "type": "string" },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "sceneId",
                "goal",
                "sceneDescription",
                "action",
                "dialogue",
                "shotType",
                "cameraMove",
                "duration"
              ],
              "properties": {
                "sceneId": { "type": "string", "pattern": "^scene-\\d{2}$" },
                "goal": { "type": "string", "minLength": 1 },
                "sceneDescription": { "type": "string", "minLength": 1 },
                "characters": { "type": "array", "items": { "type": "string" } },
                "action": { "type": "string", "minLength": 1 },
                "dialogue": { "type": "string" },
                "shotType": { "type": "string", "enum": ["EWS", "WS", "MS", "CU", "ECU"] },
                "cameraMove": {
                  "type": "string",
                  "enum": ["static", "push", "pull", "pan", "tilt", "handheld"]
                },
                "duration": { "type": "integer", "minimum": 1, "maximum": 30 },
                "assetRefs": { "type": "array", "items": { "type": "string" } },
                "rhythmPurpose": { "type": "string" },
                "continuityCue": { "type": "string" },
                "cinematicNotes": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "characters": { "type": "array", "items": { "type": "object" } },
        "scenes": { "type": "array", "items": { "type": "object" } },
        "props": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
