{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yuanlong.storyboard.v1",
  "title": "Yuanlong Storyboard Output Contract",
  "type": "object",
  "required": ["meta", "input", "selected_configuration", "global_rules", "shots", "validation"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "generated_at", "language"],
      "properties": {
        "schema_version": {"type": "string", "const": "yuanlong.storyboard.v1"},
        "generated_at": {"type": "string"},
        "language": {"type": "string"}
      }
    },
    "input": {
      "type": "object",
      "required": ["core_plot", "duration_sec", "mode", "shot_count", "audio", "safety"],
      "properties": {
        "core_plot": {"type": "string"},
        "duration_sec": {"type": "number", "minimum": 1},
        "mode": {
          "type": "object",
          "required": ["chain", "stc_enabled", "faithful_mode", "script_imported"],
          "properties": {
            "chain": {"type": "boolean"},
            "stc_enabled": {"type": "boolean"},
            "faithful_mode": {"type": "boolean"},
            "script_imported": {"type": "boolean"}
          }
        },
        "shot_count": {
          "type": "object",
          "required": ["mode", "target"],
          "properties": {
            "mode": {"type": "string", "enum": ["auto", "custom"]},
            "target": {"type": "integer", "minimum": 1}
          }
        },
        "audio": {
          "type": "object",
          "required": ["bgm_enabled", "subtitle_enabled"],
          "properties": {
            "bgm_enabled": {"type": "boolean"},
            "subtitle_enabled": {"type": "boolean"}
          }
        },
        "safety": {
          "type": "object",
          "required": ["word_filter_enabled", "auto_safety_enabled"],
          "properties": {
            "word_filter_enabled": {"type": "boolean"},
            "auto_safety_enabled": {"type": "boolean"}
          }
        }
      }
    },
    "selected_configuration": {
      "type": "object",
      "required": ["director", "visual_style", "camera_languages", "lighting_moods"],
      "properties": {
        "director": {"type": "object"},
        "visual_style": {"type": "object"},
        "camera_languages": {"type": "array", "items": {"type": "object"}},
        "lighting_moods": {"type": "array", "items": {"type": "object"}}
      }
    },
    "global_rules": {
      "type": "object",
      "required": ["dialogue_lock", "asset_tag_mode", "consistency_rules"],
      "properties": {
        "dialogue_lock": {"type": "array", "items": {"type": "string"}},
        "asset_tag_mode": {
          "type": "object",
          "required": ["character", "image", "props"],
          "properties": {
            "character": {"type": "boolean"},
            "image": {"type": "boolean"},
            "props": {"type": "boolean"}
          }
        },
        "consistency_rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "scene_id", "time", "content", "prompts", "dialogue", "assets", "continuity"],
        "properties": {
          "shot_id": {"type": "integer", "minimum": 1},
          "scene_id": {"type": "integer", "minimum": 1},
          "time": {
            "type": "object",
            "required": ["start_sec", "end_sec", "duration_sec", "range"],
            "properties": {
              "start_sec": {"type": "number", "minimum": 0},
              "end_sec": {"type": "number", "minimum": 0},
              "duration_sec": {"type": "number", "minimum": 0.1},
              "range": {"type": "string"}
            }
          },
          "content": {
            "type": "object",
            "required": ["shot_size", "camera_movement", "frame_description", "lighting_mood"],
            "properties": {
              "shot_size": {"type": "string"},
              "camera_movement": {"type": "string"},
              "frame_description": {"type": "string"},
              "lighting_mood": {"type": "string"},
              "drama_tension": {"type": "string"}
            }
          },
          "prompts": {
            "type": "object",
            "required": ["text_to_image", "image_to_video"],
            "properties": {
              "text_to_image": {"type": "string"},
              "image_to_video": {"type": "string"}
            }
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["at_sec", "speaker", "text"],
              "properties": {
                "at_sec": {"type": "number", "minimum": 0},
                "speaker": {"type": "string"},
                "text": {"type": "string"}
              }
            }
          },
          "assets": {
            "type": "object",
            "required": ["tags", "characters", "scenes", "props"],
            "properties": {
              "tags": {"type": "array", "items": {"type": "string"}},
              "characters": {"type": "array", "items": {"type": "string"}},
              "scenes": {"type": "array", "items": {"type": "string"}},
              "props": {"type": "array", "items": {"type": "string"}}
            }
          },
          "continuity": {
            "type": "object",
            "required": ["in", "out"],
            "properties": {
              "in": {"type": "string"},
              "out": {"type": "string"}
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["shot_count_expected", "shot_count_actual", "duration_total_sec", "duration_target_sec", "passed", "issues"],
      "properties": {
        "shot_count_expected": {"type": "integer", "minimum": 1},
        "shot_count_actual": {"type": "integer", "minimum": 1},
        "duration_total_sec": {"type": "number", "minimum": 0.1},
        "duration_target_sec": {"type": "number", "minimum": 0.1},
        "passed": {"type": "boolean"},
        "issues": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
